<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/local_inference_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkBlue">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <include
            android:id="@+id/inference_fixed_header"
            layout="@layout/inference_header" />

        <!-- ================= YOLO ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="LED Detection Dataset"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/yoloDatasetPathEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Select YOLO v26 Dataset"
                android:focusable="false"
                android:background="@android:color/white"
                android:padding="12dp"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/selectYoloDatasetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Open"
                android:backgroundTint="@color/yellow"
                android:textColor="@color/darkBlue" />
        </LinearLayout>

        <Button
            android:id="@+id/inferYoloButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Infer YOLO v26"
            android:backgroundTint="@color/blue"
            android:textColor="@android:color/white" />

        <!-- ================= RESNET ================= -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Emotion Detection Dataset"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/resnetDatasetPathEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Select ResNet-50 Dataset"
                android:focusable="false"
                android:background="@android:color/white"
                android:padding="12dp"
                android:textColor="@android:color/black" />

            <Button
                android:id="@+id/selectResnetDatasetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Open"
                android:backgroundTint="@color/yellow"
                android:textColor="@color/darkBlue" />
        </LinearLayout>

        <Button
            android:id="@+id/inferResnetButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:text="Infer ResNet-50"
            android:backgroundTint="@color/blue"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
